# Neon (Vercel Marketplace). Pooled URL for the app.
# If Neon injects POSTGRES_PRISMA_URL / POSTGRES_URL, the Vercel build will use those
# when DATABASE_URL is missing.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/atelier?sslmode=require"

# Auth.js — required. openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://127.0.0.1:3000"

# Google OAuth — create a Web application client in Google Cloud Console and
# add https://YOUR_DOMAIN/api/auth/callback/google as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Vercel Blob — required to persist uploaded photos
BLOB_READ_WRITE_TOKEN=""

# Required in production before accepting a custom image. This secure endpoint
# must accept multipart form field `file` and return JSON: { "clean": true }.
MALWARE_SCAN_URL=""
MALWARE_SCAN_TOKEN=""
